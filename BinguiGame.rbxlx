local C = {
	Dark = Color3.fromHex("#2a1f33"),
	Cream = Color3.fromHex("#fffbea"),
	Paper = Color3.fromHex("#f4efe2"),
	Purple = Color3.fromHex("#b39cff"),
	PurpleDark = Color3.fromHex("#26124d"),
	Lilac = Color3.fromHex("#efeaff"),
