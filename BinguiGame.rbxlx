---------------------------------------------------------------------
-- 몸 종류
-- Speed: 스터드/초, HP, Life: 빙의했을 때 버티는 시간(초)
---------------------------------------------------------------------
GameData.Bodies = {
	ghost = { Name = "혼이", Speed = 22, HP = 3, R = 1.2, Ability = "도약" },
