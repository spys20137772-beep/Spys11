	local card = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(440, height), BackgroundColor3 = C.Cream, ZIndex = 11, Parent = ov }, { stroke(nil, 4), corner(6) })
	addScale(card)
	return ov, card
end

